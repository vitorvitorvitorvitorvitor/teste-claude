{
  "name": "forja-treino-inteligente",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FORJA — Treino Inteligente: PWA de musculação offline com motor de prescrição determinístico.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
